{
  "name": "ng-advanced-table-locale",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "nat",
  "sourceRoot": "libs/ng-advanced-table/locale",
  "tags": ["type:locale", "scope:public"],
  "targets": {
    "test": {
      "inputs": ["default", "^production", "libEntryPointTsConfigs"],
      "options": {
        "buildTarget": "ng-advanced-table:build:development",
        "tsConfig": "libs/ng-advanced-table/tsconfig.spec.json",
        "coverage": true,
        "coverageInclude": ["libs/ng-advanced-table/locale/**/*.ts"],
        "coverageExclude": ["**/*.spec.ts", "**/test-helpers/**", "**/*.type.ts", "**/index.ts"],
        "coverageReporters": ["text-summary", "json-summary"],
        "coverageThresholds": { "statements": 80, "branches": 73, "functions": 85, "lines": 79 }
      }
    }
  }
}
